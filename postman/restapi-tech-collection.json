        {
          "name": "TC-05 GET companies status=INVALID (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ========== Базовые проверки ==========",
                  "pm.test(\"Статус 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Время ответа < 500ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test(\"Content-Type содержит 'application/json'\", () => ",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/json/)",
                  ");",
                  "",
                  "// ========== Проверка структуры текста ошибки ==========",
                  "pm.test(\"detail присутствует, массив, не пустой\", () => {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property(\"detail\");",
                  "    pm.expect(response.detail).to.be.an(\"array\");",
                  "    pm.expect(response.detail.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"detail содержит обязательные поля валидных типов\", () => {",
                  "    const response = pm.response.json();",
                  "    const error = response.detail[0];",
                  "    pm.expect(error).to.include.keys(\"type\",\"loc\", \"msg\");",
                  "    pm.expect(error.type).to.be.a(\"string\");",
                  "    pm.expect(error.loc).to.be.an(\"array\");",
                  "    pm.expect(error.msg).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Текст ошибки содержит статусы\", () => {",
                  "    const response = pm.response.json();",
                  "    const errorMsg = response.detail[0].msg;",
                  "    const containStatus = errorMsg.includes(\"ACTIVE\") ||",
                  "                          errorMsg.includes(\"CLOSED\") ||",
                  "                          errorMsg.includes(\"BANKRUPT\");",
                  "    pm.expect(containStatus).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
