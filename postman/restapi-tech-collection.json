                  "pm.test(\"Текст ошибки содержит хотя бы один статус\", () => {",
                  "    const response = pm.response.json();",
                  "    const errorMsg = response.detail[0].msg;",
                  "    const expectedStatuses = [\"ACTIVE\", \"CLOSED\", \"BANKRUPT\"];",
                  "    const containValidStatus = expectedStatuses.some(status => errorMsg.includes(status));",
                  "    pm.expect(containValidStatus).to.be.true;",
                  "});"
